{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "name": "Base (page background)", "color": "#ffffff" },
        { "slug": "contrast", "name": "Contrast (text)", "color": "#1a1a1a" },
        { "slug": "primary", "name": "Primary (links, buttons)", "color": "#1d4ed8" },
        { "slug": "primary-hover", "name": "Primary hover", "color": "#1e40af" },
        { "slug": "secondary", "name": "Secondary (section background)", "color": "#f3f4f6" },
        { "slug": "accent", "name": "Accent (highlights)", "color": "#d97706" },
        { "slug": "muted", "name": "Muted (captions, meta)", "color": "#6b7280" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body (system sans)",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, 'Helvetica Neue', Arial, sans-serif"
        },
        {
          "slug": "heading",
          "name": "Heading (system sans)",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, 'Helvetica Neue', Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
        { "slug": "x-large", "name": "Extra Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "2.5rem", "fluid": { "min": "2rem", "max": "2.5rem" } }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.5rem" },
        { "slug": "50", "name": "L", "size": "2.5rem" },
        { "slug": "60", "name": "XL", "size": "4rem" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary-hover)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-hover)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        "border": { "radius": "4px" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--large)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
          }
        }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
      },
      "core/post-meta": {
        "color": { "text": "var(--wp--preset--color--muted)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": []
}
